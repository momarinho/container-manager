# ==============================================================================
# Container Manager - Backend Environment Configuration (.env.example)
# ==============================================================================
# Copie este arquivo para backend/.env:
# cp backend/.env.example backend/.env
# ==============================================================================

# --- Aplicação & Servidor ---
APP_NAME=containermaster-backend
APP_VERSION=0.1.0
APP_COMMIT_SHA=local
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# --- Autenticação & Segurança ---
# JWT_SECRET deve ter no mínimo 32 caracteres
JWT_SECRET=development_jwt_secret_key_with_at_least_32_characters_123456
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# CORS_ORIGIN: Em development aceita '*'. Em production, é OBRIGATÓRIO definir origens explícitas
# separadas por vírgula (ex: https://app.dominio.com,https://painel.dominio.com). O uso de '*' é bloqueado em prod.
CORS_ORIGIN=*

# --- Docker & Banco de Dados ---
# Conexão com Docker daemon: utilize DOCKER_HOST apontando para o socket proxy seguro
# ou DOCKER_SOCKET_PATH apontando para o socket local (/var/run/docker.sock).
DOCKER_HOST=tcp://docker-proxy:2375
DOCKER_SOCKET_PATH=/var/run/docker.sock
DATABASE_PATH=database.db

# --- Logs & Telemetria ---
LOG_LEVEL=INFO
LOG_FORMAT=text
ENABLE_ACCESS_LOGS=true

# --- Rate Limiting & Throttling ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- WebSockets ---
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# --- Métricas & Buffer de Logs ---
STATS_UPDATE_INTERVAL=5000
STATS_HISTORY_SIZE=100
LOG_BUFFER_SIZE=100
LOG_FLUSH_INTERVAL=100

# --- Terminal Interativo ---
TERMINAL_IDLE_TIMEOUT=600000
TERMINAL_MAX_SESSIONS=10

# --- Provedor de Túnel (Tailscale) ---
TUNNEL_PROVIDER=tailscale
TUNNEL_STATUS_POLL_INTERVAL=5000
TAILSCALE_CLI_PATH=tailscale
TAILSCALE_API_BASE_URL=https://api.tailscale.com
TAILSCALE_API_TOKEN=
TAILSCALE_TAILNET=
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=container-manager
TAILSCALE_ACCEPT_DNS=false
TAILSCALE_ACCEPT_ROUTES=false
TAILSCALE_ADVERTISE_TAGS=
